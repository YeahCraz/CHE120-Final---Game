            self.first_boss_spike = True
        if 11 <= game_time_minutes < 12 and not hasattr(self, 'second_boss_spike'):
            self.on_spawn(70)  #DO: spike to 35 enemies
            self.second_boss_spike = True#WB: Makes the enemies spawn 
        if 24 <= game_time_minutes < 25 and not hasattr(self, 'third_boss_spike'):
            self.on_spawn(80)  #DO: spike to 45 enemies
            self.third_boss_spike = True
        self.resolve_enemy_overlaps()
            


    def shoot_weapon(self,weapon_type):
        #DO: shoots differently depending on weapon 
        if weapon_type == 'plasma':
            #DO: thanks FS ill be using ur thing as a frame work for this
            nearest_enemy = None
            min_distance = float('inf') #DO: infinity
            
            for enemy in self.enemies:
                if hasattr(enemy, 'rect'):
                    dx = enemy.rect.centerx - self.player.rect.centerx
                    dy = enemy.rect.centery - self.player.rect.centery
                    distance = math.sqrt(dx*dx + dy*dy) #DO: dist from us to them
                    
                    if distance < min_distance:
                        min_distance = distance
                        nearest_enemy = enemy
            
            #DO: Calculate angle towards nearest enemy, or use default direction if no enemies
            if nearest_enemy:
                dx = nearest_enemy.rect.centerx - self.player.rect.centerx
                dy = nearest_enemy.rect.centery - self.player.rect.centery
                angle = math.atan2(dy, dx)
            else:
                #DO:  this is iff we have no enemies (unlikely or actually impossible i believe but just in case)
                direction = self.player.current_direction
                angle = math.pi if direction == 'left' else 0
            
            velocity = 800 * self.player_stats.projectile_speed_multiplier
            base_damage = self.player_stats.get_weapon_damage('plasma')
            damage_value, is_crit = self.player_stats.calculate_damage(base_damage)
            
            projectile = self.player.player_projectile(velocity, angle, 'plasma', damage_value)
            
            if is_crit: 
                projectile.image.fill((255,255,100))
            
            return [projectile]
        elif weapon_type == 'bubble':
            velocity = 1000 * self.player_stats.projectile_speed_multiplier
            base_damage = self.player_stats.get_weapon_damage('bubble')
            num_shots = 8 + self.player_stats.weapon_levels['bubble'] * 2
            
            #DO: we get more shots per level for MR. bubbly
            projectiles = []
            for i in range(num_shots):
                angle = i * (2 * math.pi) / num_shots
                damage_value, is_crit = self.player_stats.calculate_damage(base_damage)
                projectile = self.player.player_projectile(velocity, angle, 'bubble', damage_value)
                projectiles.append(projectile)
            return projectiles
        elif weapon_type == 'laser':
            direction = self.player.current_direction
            if direction == 'left': 
                base_angle = math.pi
            else: 
                base_angle = 0 
            velocity = 2000 * self.player_stats.projectile_speed_multiplier
            base_damage = self.player_stats.get_weapon_damage('laser')
            damage_value, is_crit = self.player_stats.calculate_damage(base_damage)
            num_shots = min(5,1 + self.player_stats.weapon_levels['laser']) #DO: caps the bullets shot at 5
            spread_angle = math.radians(10)
            laser_crit_chance = (.25 + (self.player_stats.weapon_levels['laser'] * .1)) + self.player_stats.crit_chance
            laser_crit_damage = 2. + self.player_stats.crit_multiplier
            
            projectiles = []
            for i in range(num_shots):
                angle_offset = spread_angle * (i - (num_shots - 1) / 2)
                angle = base_angle + angle_offset
                # DO: Use the combined crit system
                damage_value, is_crit = self.player_stats.calculate_damage(base_damage)
                # DO: Apply laser crit on top of player crit
                if random.random() < laser_crit_chance:
                    damage_value *= laser_crit_damage  #DO: crit damage multiplier
                    is_crit = True
                projectile = self.player.player_projectile(velocity, angle, 'laser', damage_value)
            
                if is_crit:
                    projectile.image.fill((255, 100, 100))
                projectiles.append(projectile)
            return projectiles

        return []
            
            
    def on_render(self): #DO: Render the display
        #DO: likely not needed anymore self.screen.fill((50,50,100)) #DO: reset the screen to black
        #self.draw_map(self.tmx_data, self.screen,self.tile_width,self.tile_height)
        #self.all_sprites.draw(self.screen) #DO: Draw all sprites in the all_sprites group to the screen
        self.camera.custom_draw(self.width, self.height, self.player, self.all_sprites, self.screen)
        for damage_num in self.damage_numbers:
            offset_pos = damage_num.rect.topleft - self.camera.offset
            self.screen.blit(damage_num.image, offset_pos)
        self.draw_hud()
        self.draw_upgrade_gui()
        #DO: Layering
        pygame.display.flip() #DO: Update the full display surface to the screen

    

    def on_cleanup(self): #DO: cleanup resources
        pygame.quit() #DO: quits pygame
        exit() #DO: kills program no matter what
    

    def create_background_surface(self):
        #DO: determines size of world from tmx file
        map_width = self.tmx_data.width *self.tile_width
        map_height = self.tmx_data.height *self.tile_height
        #DO: creating a surface with the approriate dimensions of the world
        out = pygame.Surface((map_width, map_height))
        #DO:Call Draw map to draw on surface
        #DO: neededd if the background is black or smth at some area out.fill((50,50,100))
        self.draw_map(self.tmx_data,out,self.tile_width,self.tile_height)
        return out
    def load_walls(self):
        #DO: loads objects from tilemap for collisions
        #DO:try catch time
        try:
            walls_layer = None #DO: Initalize wall output
            for layer in self.tmx_data.layers: #DO: parses layers in the file
                if layer.name == 'Walls': #DO: if the Walls file is found it makes this layer our "layer" variable
                    walls_layer = layer
                    break
            if hasattr(walls_layer, 'data'):#DO: is there anything in this layer
                for x, y, gid in walls_layer: #DO: creates rects for collision for each wall sprite
                    if gid != 0: #DO: gid = 0 means empty
                        wall_rect = pygame.Rect(x*self.tile_width,y*self.tile_height,self.tile_width,self.tile_height)
                        self.collision_rects.append(wall_rect)
    
        except Exception as e:
            print(f'Error loading walls {e}')
            #DO: if the wall layer cannot be found catches it and prints out this line


    def draw_map(self, tmx_data, surface, tile_width, tile_height): #DO: draws a map based on given parameters using a desired map file  (as seen in the init)
        #DO: surface or screen both should work
        for layer in tmx_data.visible_layers: #DO: For each layer in our layered map
            if isinstance(layer, pytmx.TiledTileLayer):
                for x, y, gid in layer: 
                    tile = tmx_data.get_tile_image_by_gid(gid)
                    if tile: #DO: if it is a tile it blits the tile on screen
                        surface.blit(tile, (x * tile_width, y * tile_height)) 

    def on_execute(self): #DO: Execute the application
        if not self.on_init(): #DO:initalize the application
            self._running = False
 
        while self._running: #DO: game loop in which events, loop logic, then rendering occurs
            self.dt = self.clock.tick(144) / 1000.0 #DO: Calculate delta time in seconds
            for event in pygame.event.get(): #DO: Event handling loop
                self.on_event(event)
            self.on_loop() #DO: main loop logic
            self.on_render() #DO: render the display
        self.on_cleanup() #DO: cleanup prior to quitting
if (__name__ == "__main__") : #DO: Run the application
    the_app = App()
    the_app.on_execute()