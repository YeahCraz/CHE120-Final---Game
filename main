        #DO: level tracking text
        level_text = font.render(f"Lvl: {self.player_stats.level}", True, (255, 255, 255))
        exp_text = font.render(f"EXP: {self.player_stats.exp}/{self.player_stats.exp_to_next_level}", True, (21, 71, 52))
        
        self.screen.blit(level_text, (20, 50))
        self.screen.blit(exp_text, (20, 75))
       
        #DO: in game clock
        game_time_seconds = (pygame.time.get_ticks() - self.game_start_time) // 1000
        minutes = game_time_seconds // 60
        seconds = game_time_seconds % 60
        time_text = font.render(f"Time: {minutes:02d}:{seconds:02d}", True, (200, 200, 200))
        self.screen.blit(time_text, (20, 100))
        
        
    def spawn_at_edge(self,enemy_type):  #DO: Spawn enemy at screen edge with random angle
        #DO: Spawn enemy at screen edge with random angle
        player_x = self.player.rect.centerx
        player_y = self.player.rect.centery
        
        #DO: Use screen dimensions for edge spawning
        screen_width, screen_height = self.size
        spawn_distance = max(screen_width, screen_height) // 2  #DO: distance to edge of screen
        
        #DO: Generate random angle
        angle = random.uniform(0, 2 * math.pi)
        
        #DO: Calculate position at edge distance
        enemy_x = player_x + math.cos(angle) * spawn_distance
        enemy_y = player_y + math.sin(angle) * spawn_distance
        
        return Enemy(enemy_x, enemy_y, enemy_type)
    
    def on_spawn(self,number_enemies,boss=False): #WB: Makes the enemies spawn in the game 
        if boss == True:
            enemy_type = 'boss'
            new_enemy = self.spawn_at_edge(enemy_type)
            base_hp = 3000 #DO: Boss base health
            new_enemy.max_health = self.calculate_enemy_health(base_hp)
            new_enemy.health = new_enemy.max_health
            
            self.enemies.add(new_enemy)
            self.all_sprites.add(new_enemy)
        
        if len(self.enemies) < number_enemies: #WB: There is always a fixed number of x enemies in the game. If the number is lower than 3, it adds more enemies so that the number stays 3.
            chance = random.random() #WB: Randomly selects the enemy to add to the game based on probability     
            #WB: Each enemy has a likely or less likely chance to appear on screen
            weights = self.get_enemy_spawn_weights()
            enemy_type = random.choices(list(weights.keys()), weights=list(weights.values()))[0]
            #DO: Base enemy health
            base_health ={
                'standard' : 40,
                'moderate' : 60,
                'strong' : 70,
                'boss' : 250
            }
            
            new_enemy = self.spawn_at_edge(enemy_type) #WB: Creates a variable to add the new enemy
            base_hp = base_health[enemy_type]
            new_enemy.max_health = self.calculate_enemy_health(base_hp)
            new_enemy.health = new_enemy.max_health
            
            self.enemies.add(new_enemy) #WB: Adds the new enemy to the enemies group
            self.all_sprites.add(new_enemy) #WB: Adds the new enemy to the all sprites group

    def resolve_enemy_overlaps(self):
        #DO:Enemies are overlapping this is unacceptable
     # DO: Enemies are overlapping this is unacceptable
        enemies_list = list(self.enemies) #DO: list of mr evil guys
        
        for i, enemy1 in enumerate(enemies_list): #DO: enumerate allows us to index the enemies in the list without manueal indexing
            for enemy2 in enemies_list[i+1:]:
                # DO: uses mask collision instead of rect collision
                if pygame.sprite.collide_mask(enemy1, enemy2):
                    #DO: calculate overlap using rects for push strength
                    overlap_rect = enemy1.rect.clip(enemy2.rect)
                    
                    # DO: push amount based on centres
                    dx = enemy1.rect.centerx - enemy2.rect.centerx
                    dy = enemy1.rect.centery - enemy2.rect.centery
                    
                    if dx == 0 and dy == 0:
                        dx, dy = 1, 0  #DO: push right to avodi division by zero if both were 0
                    
                    #DO: Normalize the distance pushed
                    distance = math.sqrt(dx*dx + dy*dy)
                    if distance > 0:
                        dx, dy = dx/distance, dy/distance
                        
                        #DO: Push based on overlap size (more overlap = stronger push)
                        push_strength = min(overlap_rect.width, overlap_rect.height) * 0.5
                        push_strength = max(2, min(10, push_strength))  #DO: avoid pushing too much
                        
                        enemy1.rect.x += dx * push_strength
                        enemy1.rect.y += dy * push_strength
                        enemy2.rect.x -= dx * push_strength
                        enemy2.rect.y -= dy * push_strength


    def on_loop(self): #DO: Main loop logic
        current_time = pygame.time.get_ticks() #DO: there is some code in here using this and id rather not look for it.
        if self.game_paused:
            if self.upgrade_gui_active:
                self.handle_upgrade_selection()
            return
      
        #DO: calculate attack interval based on player stats
       # attack_interval_1 = self.player_stats.get_attack_interval(self.attack_interval_1_base)
