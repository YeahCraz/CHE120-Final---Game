            self.on_spawn(100) 
        else:
            self.on_spawn(150) 

        if game_time_minutes >= 3 and not hasattr(self, 'first_boss_spawned'):
            self.on_spawn(1,boss=True)
            self.first_boss_spawned = True
        elif game_time_minutes >= 8 and not hasattr(self,'second_boss_spawned'):
            self.on_spawn(1,boss=True)
            self.second_boss_spawned = True
        elif game_time_minutes >= 15 and not hasattr(self,'third_boss_spawned'):
