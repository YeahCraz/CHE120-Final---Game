        player_x = self.player.rect.centerx #WB: Gets the player's x position first as the position of the enemy always depends on the player's
        player_y = self.player.rect.centery #WB: Gets the player's y position first as the position of the enemy always depends on the player's
        x = random.randint (player_x - 500, player_x + 500) #WB: Makes it so that the enemy can randomly spawn from anywhere between 500 pixels to the right or to the left of the player
        y = random.randint (player_y - 500, player_y + 500) #WB: Makes it so that the enemy can randomly spawn from anywhere between 500 pixels up or down from the player
       # if current_time - self.shooting_enemy_time > self.shooting_enemy_interval: #WB: Checks if 30 seconds have passed 
