    def on_player_level_up(self):
        #DO: called when player lvls up
        self.generate_upgrade_options()
        self.upgrade_gui_active = True
        self.game_paused = True
    
    def handle_upgrade_selection(self):
        keys = pygame.key.get_pressed()
        #DO: Takes 1,2,3 nnumber input and gives you the upgrade selected (also light error handling)
        if keys[K_1]:
            self.apply_up(self.upgrade_options[0])
            self.upgrade_gui_active = False
            self.game_paused = False
        elif keys[K_2] and len(self.upgrade_options) > 1:
            self.apply_up(self.upgrade_options[1])
            self.upgrade_gui_active = False
            self.game_paused = False
        elif keys[K_3] and len(self.upgrade_options) > 2:
            self.apply_up(self.upgrade_options[2])
            self.upgrade_gui_active = False
            self.game_paused = False
    def on_event(self, event): #DO: Handle events
        if event.type == pygame.QUIT: #DO: if the user clicks the close button ends program
            self._running = False
    def get_game_time_minutes(self):
        #DO: how many minutes has it been since game began?
        return (pygame.time.get_ticks() - self.game_start_time) / 60000. #DO: conversion of ms to min
    
    def calculate_enemy_health(self, base_health):
        game_time_minutes = self.get_game_time_minutes()
        time_factor = min(game_time_minutes / 10, 4.0)  
        return base_health * (1 + time_factor * 1.5)
#DO: nemy spawn rates should also evolve
    def get_enemy_spawn_weights(self):
        game_time_minutes = self.get_game_time_minutes()
        if game_time_minutes < 5:
            return {'standard': 0.7, 'moderate': 0.25, 'strong': 0.05}
        elif game_time_minutes < 15:
            return {'standard': 0.5, 'moderate': 0.35, 'strong': 0.15}
        else:
            return {'standard': 0.3, 'moderate': 0.4, 'strong': 0.3}
    def generate_upgrade_options(self):
#DO:list of stats
        stat_upgrades = [
            ('max_health', "Max Health", "+25 HP"),  
            ('move_speed', 'Move Speed', '+8% Speed'),  
            ('damage', 'Damage', '+15% Damage'),  
            ('attack_speed', 'Attack Speed', '+5% Attack Speed'),  
            ('projectile_size', 'Projectile Size', '+20% Size'), 
            ('projectile_speed', 'Projectile Speed', '+20% Speed'),  
            ('crit_chance', 'Crit Chance', '+5% Crit Chance'),  
            ('health_regen', 'Health Regen', '+0.3 HP/s'),  
            ('exp_growth', 'EXP Gain', '+10% EXP'),  
            ('crit_multiplier', 'Crit Damage', '+0.5x Multiplier')  
        ] #DO: surely more balanced
    #DO: list of possible weapon upgrades
        weapon_upgrades = []
        available_weapons = ['plasma','bubble','laser']

        for weapon in self.player_stats.active_weapons:
            if self.player_stats.weapon_levels[weapon] < 5:
                weapon_upgrades.append((weapon, f'{weapon.title()} Lv {self.player_stats.weapon_levels[weapon] +1}', f'Upgrade {weapon}'))
        
        #DO: unowned weapons
        for weapon in available_weapons:
            if weapon not in self.player_stats.active_weapons and len(self.player_stats.active_weapons) < 3:
                weapon_upgrades.append((weapon,f'new: {weapon.title()}', f'Unlock {weapon} weapon' ))
         #DO: create a list of all options for randomizing
        all_options = stat_upgrades + weapon_upgrades
        #DO: picks 3 of the options randomly
        if len(all_options) > 0:
            self.upgrade_options = random.sample(all_options,min(3,len(all_options)))
        else:
            self.upgrade_options = []
    def apply_up(self,upgrade):
        upgrade_type, name, description = upgrade #DO: uses the tuples from earlier
        success = self.player_stats.upgrade(upgrade_type) #DO: calls the player stats code to check for an upgrade (and to apply it within the player code)
        if success:
            if upgrade_type == 'move_speed': 
                self.player.speed = 350 * self.player_stats.move_speed_multiplier
            elif upgrade_type == 'max_health':
                self.player.health = self.player_stats.current_health
                self.player.max_health = self.player_stats.max_health
        return success
