                            print("Enemy defeated!")
        #DO: actual implementation of health regen per tick
        self.player.health = min(self.player.max_health, self.player.health + self.player_stats.health_regen * self.dt)
        print(self.player.health)
        game_time_minutes = self.get_game_time_minutes()
        #DO: Basic enemy progression
        if game_time_minutes < 1:
            self.on_spawn(3)
        elif game_time_minutes < 2:
            self.on_spawn(6)
        elif game_time_minutes < 3:
            self.on_spawn(12)
